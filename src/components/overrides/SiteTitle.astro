---
// The site logo in the header: the per-theme logo from /img/logo, so it follows the active theme.
---

<a
  href="/"
  class="mt-site-logo"
  aria-label="Material Theme UI"
>
  <span
    class="mt-logo-img"
    aria-hidden="true"
  ></span>
</a>

<style>
  .mt-site-logo {
    display: block;
    line-height: 0;
  }

  .mt-logo-img {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
  }
</style>
