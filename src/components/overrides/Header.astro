---
// Starlight's default header plus the five top links on desktop.
// The default component has no slot for extra content, so this re-composes the same building blocks.
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { topLinks } from '../../config/site';

const { pathname } = Astro.url;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>

  <nav
    class="top-links sl-hidden lg:sl-flex print:hidden"
    aria-label="Main"
  >
    {topLinks.map((link) => (
      <a
        href={link.href}
        aria-current={
          pathname.startsWith(link.href.split('/').slice(0, 3).join('/'))
            ? 'page'
            : undefined
        }
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="search sl-flex print:hidden">
    <Search />
  </div>

  <div class="right-group sl-hidden md:sl-flex print:hidden">
    <div class="social-icons sl-flex">
      <SocialIcons />
    </div>
    <ThemeSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .top-links {
      gap: 1.25rem;
      align-items: center;
    }

    .top-links a {
      color: var(--sl-color-gray-2);
      text-decoration: none;
      font-size: var(--sl-text-sm);
      white-space: nowrap;
    }

    .top-links a:hover,
    .top-links a[aria-current='page'] {
      color: var(--sl-color-accent);
    }

    .search {
      flex: 1;
      justify-content: flex-end;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }
  }
</style>
