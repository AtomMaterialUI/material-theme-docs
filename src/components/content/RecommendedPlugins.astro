---
// Replaces _includes/recommended-plugins.html, fed by src/data/recommendedPlugins.yml.
import { recommendedPlugins } from '../../data/site';
---

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
    </tr>
  </thead>

  <tbody>
    {recommendedPlugins.map((plugin) => (
      <tr>
        <td>
          <a href={plugin.url}>{plugin.title}</a>
        </td>
        <td>{plugin.description}</td>
      </tr>
    ))}
  </tbody>
</table>
