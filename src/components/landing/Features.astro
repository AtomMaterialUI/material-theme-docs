---
// Replaces the _features collection + feature.html: six tiles read from src/data/features.yml.
import { readData } from '../../data/load';

interface Feature {
  title: string;
  image: string;
  text: string;
}

const features = readData<Feature[]>('features.yml');
---

<section class="not-content mt-features">
  <h2>Features</h2>

  <ul>
    {features.map((feature) => (
      <li>
        <img
          src={`/img/features/${feature.image}`}
          alt=""
          width="450"
          height="253"
          loading="lazy"
        />
        <h3>{feature.title}</h3>
        <p>{feature.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .mt-features h2 {
    text-align: center;
    color: var(--sl-color-accent);
    font-weight: 400;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    padding: 0;
    margin: 1.5rem 0;
    list-style: none;
  }

  li {
    padding: 1rem;
    text-align: center;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h3 {
    margin: 0.5rem 0 0.25rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }

  p {
    margin: 0;
    color: var(--sl-color-gray-2);
  }
</style>
