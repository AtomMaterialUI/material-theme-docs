---
// One Carbon Ads slot. Only layout overrides render it, so authors never place ads.
// Several slots can exist in the DOM (sidebar, ribbon, hero) but only one is visible at a given
// width; the script below loads Carbon into the first visible one, so a page never shows two ads.
interface Props {
  placement: 'sidebar' | 'ribbon' | 'hero';
  class?: string;
}

const { placement, class: className } = Astro.props;
---

<div
  class:list={['mt-carbon', className]}
  data-carbon-slot={placement}
></div>

<script>
  const slot = [
    ...document.querySelectorAll<HTMLElement>('[data-carbon-slot]'),
  ].find((el) => el.offsetParent !== null);

  if (slot) {
    const script = document.createElement('script');

    script.async = true;
    script.id = '_carbonads_js';
    script.src =
      '//cdn.carbonads.com/carbon.js?zoneid=1673&serve=C6AILKT&placement=materialthemecom';
    slot.append(script);
  }
</script>

<style>
  .mt-carbon {
    margin-top: 1rem;
    margin-inline-end: 1rem;
    max-width: 330px;
  }

  .mt-carbon[data-carbon-slot='hero'] {
    margin-inline: auto;
  }

  /* Carbon injects #carbonads at runtime, so these styles must be global. */
  .mt-carbon :global(#carbonads) {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    box-sizing: border-box;
    color: var(--sl-color-text);
    display: block;
    font-size: 0.8125rem;
    line-height: 1.4;
    min-height: 126px;
    padding: 1rem 1rem 1rem 160px;
    text-align: left;
  }

  .mt-carbon :global(#carbonads a),
  .mt-carbon :global(#carbonads a:hover) {
    color: inherit;
    text-decoration: none;
  }

  .mt-carbon :global(#carbonads .carbon-img) {
    float: left;
    margin-inline: -150px 1rem;
  }

  .mt-carbon :global(#carbonads .carbon-img img) {
    display: block;
    height: auto;
    max-width: 130px;
  }

  .mt-carbon :global(#carbonads .carbon-poweredby) {
    display: block;
    font-size: smaller;
    opacity: 0.7;
    padding-top: 0.75rem;
  }
</style>
