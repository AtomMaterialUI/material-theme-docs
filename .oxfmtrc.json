{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "singleAttributePerLine": true,
  "ignorePatterns": [
    "dist",
    ".astro",
    "pnpm-lock.yaml",
    "public",
    "*.astro",
    "docs",
    "_features",
    "_data",
    "_includes",
    "_layouts",
    "_posts",
    "_sass",
    "*.md",
    "*.yml",
    "index.html",
    "netlify.toml",
    "renovate.json",
    "*.yaml"
  ]
}
